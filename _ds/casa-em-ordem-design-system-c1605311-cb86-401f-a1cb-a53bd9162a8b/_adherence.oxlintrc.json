{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/web-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Manrope|IBM Plex Sans))/i]",
        "message": "Font not provided by the design system. Available: Manrope, IBM Plex Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|month|year|onPeriodChange|showPeriod|onSettings|actions|compact|style|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: title, eyebrow, month, year, onPeriodChange, showPeriod, onSettings, actions, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<BottomNav> doesn't accept that prop. Declared props: active, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:resumo|entradas|saidas|dividas|futuro|faturas)$/]",
        "message": "<BottomNav> active must be one of 'resumo' | 'entradas' | 'saidas' | 'dividas' | 'futuro' | 'faturas'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|fullWidth|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, fullWidth, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|soft|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'soft' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|action|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, subtitle, action, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|label|size|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CategoryChip> doesn't accept that prop. Declared props: category, label, size, active, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryChip'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:casa|carro|pessoal|divida|futuro|outros)$/]",
        "message": "<CategoryChip> category must be one of 'casa' | 'carro' | 'pessoal' | 'divida' | 'futuro' | 'outros'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<CategoryChip> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|action|tone|compact|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, description, action, tone, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|accent|alert)$/]",
        "message": "<EmptyState> tone must be one of 'primary' | 'accent' | 'alert'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|tone|size|iconSize|bordered|disabled|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, tone, size, iconSize, bordered, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|primary|danger)$/]",
        "message": "<IconButton> tone must be one of 'neutral' | 'primary' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|category|amount|kind|onEdit|onDelete|divider|style|key|ref|className|style|children)$/]",
        "message": "<ListItem> doesn't accept that prop. Declared props: title, meta, category, amount, kind, onEdit, onDelete, divider, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListItem'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:casa|carro|pessoal|divida|futuro|outros)$/]",
        "message": "<ListItem> category must be one of 'casa' | 'carro' | 'pessoal' | 'divida' | 'futuro' | 'outros'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListItem'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:in|out|debt)$/]",
        "message": "<ListItem> kind must be one of 'in' | 'out' | 'debt'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|onChange|hint|error|size|tone|disabled|id|style|key|ref|className|style|children)$/]",
        "message": "<MoneyInput> doesn't accept that prop. Declared props: label, value, defaultValue, onChange, hint, error, size, tone, disabled, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyInput'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<MoneyInput> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyInput'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:in|debt)$/]",
        "message": "<MoneyInput> tone must be one of 'in' | 'debt'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PeriodSelector'] > JSXAttribute > JSXIdentifier[name!=/^(?:month|year|defaultMonth|defaultYear|onChange|compact|style|key|ref|className|style|children)$/]",
        "message": "<PeriodSelector> doesn't accept that prop. Declared props: month, year, defaultMonth, defaultYear, onChange, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|current|target|tone|label|caption|height|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, max, current, target, tone, label, caption, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|accent|alert|success)$/]",
        "message": "<ProgressBar> tone must be one of 'primary' | 'accent' | 'alert' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onSelect|onSettings|style|key|ref|className|style|children)$/]",
        "message": "<Sidebar> doesn't accept that prop. Declared props: active, onSelect, onSettings, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sidebar'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:resumo|entradas|saidas|dividas|futuro|faturas)$/]",
        "message": "<Sidebar> active must be one of 'resumo' | 'entradas' | 'saidas' | 'dividas' | 'futuro' | 'faturas'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SummaryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|icon|tone|delta|deltaTone|footer|size|style|key|ref|className|style|children)$/]",
        "message": "<SummaryCard> doesn't accept that prop. Declared props: label, value, icon, tone, delta, deltaTone, footer, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SummaryCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|primary|accent|alert)$/]",
        "message": "<SummaryCard> tone must be one of 'default' | 'primary' | 'accent' | 'alert'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SummaryCard'] > JSXAttribute[name.name='deltaTone'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<SummaryCard> deltaTone must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SummaryCard'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<SummaryCard> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|onChange|placeholder|hint|error|icon|type|disabled|id|style|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: label, value, defaultValue, onChange, placeholder, hint, error, icon, type, disabled, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|date|email|search)$/]",
        "message": "<TextInput> type must be one of 'text' | 'date' | 'email' | 'search'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
